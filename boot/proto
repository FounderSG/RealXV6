dev     d--755 0 0
        console c--666 0 0 0 0
        rk0     b--644 0 0 0 0
        rk1     b--644 0 0 0 1
        rk2     b--644 0 0 0 2
        rk3     b--644 0 0 0 3
        mem     c--644 0 0 1 0
        kmem    c--644 0 0 1 1
        null    c--644 0 0 1 2
        $
etc     d--755 0 0
$
tmp     d--777 0 0
$
usr     d--755 0 0
        source  d--755 0 0
        $
$
readme.txt ---755 0 0 ../readme.txt
$

: mkfs proto file format
: boot sector (currently unused)
: filsys_blks inode_blks swap_blks
: root_dir
: input_lines...
: $
:
: input_line
:   name modestr uid gid external_path
: modestr (ex: d--755 or ---666)
: ---     file
: b--     block
: c--     char
: d--     directory (adds next lines to directory until '$')
:  u      setuid
:   g     setgid
:    666  mode
